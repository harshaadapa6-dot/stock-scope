# Copy this file to ".env" and fill in your own key.
# Get a free key at https://twelvedata.com (sign up -> API key).
# Leave empty to run in demo mode (no network needed).
#
# SECURITY NOTE: values bundled into a Flutter app can be extracted from the
# APK. This is acceptable for a lab project / personal key only. For a
# production app, keep the key on a backend that proxies provider requests.
TWELVE_DATA_API_KEY=your_api_key_here
